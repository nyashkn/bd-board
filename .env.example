# Path to the bd binary (1.3.0 or newer). Defaults to `bd` on PATH.
BD_BIN=bd
# Name that comments written from the board are recorded under. Unset: bd decides
# (BD_ACTOR, BEADS_ACTOR, `bd config actor`, git user.name, $USER).
# BD_BOARD_AUTHOR=
TANSTACK_CLI_TELEMETRY_DISABLED=1

# Telemetry (OpenObserve RUM): OFF unless enabled AND a token is set. No values live in the repo.
# Build-time defaults for the web build; `~/.config/bd-board/rum.json` (or O2_RUM_* on the server)
# overrides them at runtime without a rebuild. See README "Telemetry (OpenObserve RUM)".
# VITE_O2_RUM_ENABLED=
# VITE_O2_RUM_SITE=
# VITE_O2_RUM_ORG=
# VITE_O2_RUM_APP_NAME=
# VITE_O2_RUM_APP_ID=
# VITE_O2_RUM_CLIENT_TOKEN=
# VITE_O2_RUM_ENV=
# VITE_O2_RUM_PROFILE=
# VITE_O2_RUM_SAMPLE_RATE=
# VITE_O2_RUM_REPLAY_SAMPLE_RATE=
# VITE_O2_RUM_INSECURE_HTTP=
# Server-side runtime overrides (same names without VITE_): O2_RUM_ENABLED, O2_RUM_SITE, ...
# Emits hidden source maps for scripts/upload-sourcemaps.sh:
# O2_RUM_SOURCEMAPS=
